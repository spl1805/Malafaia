{
  "name": "lume-image-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:portable": "tsc -b && vite build --mode portable",
    "package:portable": "npm run build:portable && python3 scripts/package-portable.py",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build:portable && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
